# Copiá este archivo como .env y completá los valores reales.

# Conexión a PostgreSQL (una base propia para este sitio)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/base"

# Contraseña del panel de administración (/login). Elegí una larga y no la subas al repo.
ADMIN_PASSWORD=""

# Secreto para firmar las sesiones (administración y fiscales). Mínimo 32 caracteres aleatorios.
# Se puede generar con: openssl rand -hex 32
SESSION_SECRET=""

# Dirección pública del sitio (para compartir en redes y el sitemap)
NEXT_PUBLIC_SITE_URL="https://el-dominio-que-elijan.com.ar"

# (Opcional) Una cuenta de Cloudinary propia para subir fotos desde el panel y las fotos de las actas.
# Sin Cloudinary, las fotos de actas se guardan comprimidas en la base y las imágenes del panel se cargan por enlace.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""   # nombre del "upload preset" sin firma creado en esa cuenta

# (Opcional) Contacto que se muestra en el sitio
NEXT_PUBLIC_WHATSAPP=""        # solo números con código de país, ej: 5493454000000
NEXT_PUBLIC_INSTAGRAM=""       # enlace completo
NEXT_PUBLIC_FACEBOOK=""        # enlace completo

# (Opcional) Teléfono del comando central: aparece como botón "Llamar" en la pantalla de los fiscales
NEXT_PUBLIC_TELEFONO_COMANDO=""
